

# Goアプリ用
DB_USER=test_user
DB_PASSWORD=test_password
DB_HOST=db
DB_PORT=3306
DB_NAME=within_db
PORT=8080

# ローカルと本番のフロントURLをカンマ区切りで
FRONTEND_ORIGINS=http://localhost:3000,https://xxxx.amplifyapp.com

# 32文字以上のランダム文字列（例：パスワード生成サイト等）
SESSION_SECRET=your-very-long-random-string-32chars-minimum

# ローカルはhttpなのでfalseでOK
COOKIE_SECURE=false

# ローカルはNoneにしない（まずはLaxで）
COOKIE_SAMESITE_NONE=false
